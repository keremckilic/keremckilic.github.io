---
import type { Entry } from '~/data/profile';

export interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<ul class="space-y-10">
  {
    entries.map((e) => (
      <li class="grid gap-y-1 md:grid-cols-[10rem_1fr] md:gap-x-8">
        <span class="text-sm text-muted md:pt-1.5">{e.dates}</span>
        <div>
          {/* Hanging indent: first line flush left, wrapped lines indented. */}
          <h3 class="pl-5 -indent-5 text-xl font-bold leading-snug text-heading">
            {e.title}
            {e.org && <span class="font-normal italic">, {e.org}</span>}
          </h3>
          {e.bullets && (
            <div class="mt-3 space-y-2 text-default">
              {e.bullets.map((b) => (
                <p class="pl-5 -indent-5">{b}</p>
              ))}
            </div>
          )}
        </div>
      </li>
    ))
  }
</ul>
