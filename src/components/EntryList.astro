---
import type { Entry } from '~/data/profile';

export interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<ul class="space-y-8">
  {
    entries.map((e) => (
      <li>
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-x-6">
          <h3 class="text-lg font-semibold text-heading">
            {e.title}
            {e.org && <span class="font-normal text-muted">, {e.org}</span>}
          </h3>
          <span class="text-sm text-muted whitespace-nowrap">{e.dates}</span>
        </div>
        {e.bullets && (
          <ul class="mt-2 list-disc pl-5 space-y-1 text-default">
            {e.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>
