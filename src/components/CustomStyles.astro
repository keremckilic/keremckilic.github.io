---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-source-serif);
    --aw-font-serif: var(--font-source-serif);
    --aw-font-heading: var(--font-source-serif);

    /* Monochrome: links and accents stay black; emphasis comes from underlines and weight. */
    --aw-color-primary: rgb(0 0 0);
    --aw-color-secondary: rgb(64 64 64);
    --aw-color-accent: rgb(64 64 64);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    /* Off-white page background. Change this one value to experiment. */
    --aw-color-bg-page: #faf9f6;

    --aw-color-bg-page-dark: rgb(8 9 10);

    ::selection {
      background-color: rgb(0 0 0 / 14%);
    }
  }
</style>
