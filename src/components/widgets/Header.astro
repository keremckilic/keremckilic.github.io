---
import { trimSlash } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
}

export interface Props {
  links?: Array<Link>;
  isSticky?: boolean;
}

const { links = [], isSticky = false } = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const isActive = (href?: string) => typeof href === 'string' && `/${trimSlash(href)}` === currentPath;
---

<header
  class:list={[
    isSticky ? 'sticky top-0 z-40' : 'relative',
    'w-full bg-[color-mix(in_srgb,var(--aw-color-bg-page)_90%,transparent)] backdrop-blur-md',
  ]}
>
  <div class="mx-auto max-w-4xl px-4 md:px-6 py-4">
    <nav aria-label="Main navigation">
      <ul class="flex gap-6 text-base">
        {
          links.map(({ text, href }) => (
            <li>
              <a
                href={href}
                class:list={['underline-offset-4 hover:underline', { underline: isActive(href) }]}
                aria-current={isActive(href) ? 'page' : undefined}
              >
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
