---
import Layout from '~/layouts/PageLayout.astro';
import EntryList from '~/components/EntryList.astro';
import { research, projects } from '~/data/profile';

const metadata = { title: 'Research' };
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-4xl px-4 md:px-6 pt-[12vh] pb-16 md:pb-24">
    <h1 class="text-5xl md:text-7xl font-bold leading-none tracking-tight text-heading">Research</h1>

    <h2 class="mt-16 md:mt-24 mb-8 text-sm uppercase tracking-widest text-muted">Supervised research</h2>
    <EntryList entries={research} />

    <h2 class="mt-16 mb-8 text-sm uppercase tracking-widest text-muted">Course projects</h2>
    <EntryList entries={projects} />
  </div>
</Layout>
