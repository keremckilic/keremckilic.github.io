---
import Layout from '~/layouts/PageLayout.astro';
import EntryList from '~/components/EntryList.astro';
import { research, projects } from '~/data/profile';

const metadata = { title: 'Research' };
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-3xl px-4 md:px-6 pt-10 md:pt-16 pb-16 md:pb-24">
    <h1 class="text-4xl font-bold tracking-tight text-heading">Research</h1>
    <p class="mt-3 text-muted">Supervised research and course projects.</p>

    <h2 class="mt-10 text-2xl font-bold text-heading">Supervised research</h2>
    <div class="mt-6">
      <EntryList entries={research} />
    </div>

    <h2 class="mt-14 text-2xl font-bold text-heading">Course projects</h2>
    <div class="mt-6">
      <EntryList entries={projects} />
    </div>
  </div>
</Layout>
