---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { profile, about, news } from '~/data/profile';

const metadata = {
  title: profile.name,
  ignoreTitleTemplate: true,
  description: `${profile.name}: master's student in control, learning and robotics at ETH Zurich.`,
};
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-3xl px-4 md:px-6 pt-10 md:pt-16 pb-16 md:pb-24">
    <!-- Top: name and pronunciation on the left, photo on the right -->
    <header class="flex items-start justify-between gap-6">
      <div>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-heading">{profile.name}</h1>
        <p class="mt-3 text-muted">
          <span class="block sm:inline">{profile.pronunciationRespelling}</span>
          <span class="mx-1.5 hidden sm:inline" aria-hidden="true">·</span>
          <span class="block sm:inline font-mono text-sm whitespace-nowrap">{profile.pronunciationIpa}</span>
        </p>
      </div>
      <img
        src={profile.photo}
        alt={profile.photoAlt}
        width="160"
        height="160"
        class="h-28 w-28 md:h-40 md:w-40 shrink-0 rounded-full object-cover"
      />
    </header>

    <section id="about" class="mt-12 scroll-mt-20">
      <h2 class="text-2xl font-bold text-heading">About me</h2>
      <div class="mt-4 space-y-4 text-default">
        {about.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section id="news" class="mt-12 scroll-mt-20">
      <h2 class="text-2xl font-bold text-heading">Recent news</h2>
      <ul class="mt-4 space-y-3">
        {
          news.map((n) => (
            <li class="flex flex-col sm:flex-row gap-x-6">
              <span class="sm:w-24 shrink-0 text-sm text-muted sm:pt-0.5">{n.date}</span>
              <span class="text-default">{n.text}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="contact" class="mt-12 scroll-mt-20">
      <h2 class="text-2xl font-bold text-heading">Reaching out</h2>
      <p class="mt-4 text-default">
        I am happy to hear from people working on control, optimization and learning. The easiest way to reach me is by
        email.
      </p>
      <ul class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
        <li class="flex items-center gap-2">
          <Icon name="tabler:mail" class="h-5 w-5" />
          {
            profile.email ? (
              <a href={`mailto:${profile.email}`} class="underline hover:text-link">
                {profile.email}
              </a>
            ) : (
              <span class="text-muted italic">[email address to be added]</span>
            )
          }
        </li>
        {
          profile.links.map((l) => (
            <li class="flex items-center gap-2">
              <Icon name={l.icon} class="h-5 w-5" />
              <a href={l.href} class="underline hover:text-link" rel="noopener">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
