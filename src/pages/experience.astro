---
import Layout from '~/layouts/PageLayout.astro';
import EntryList from '~/components/EntryList.astro';
import { experience } from '~/data/profile';

const metadata = { title: 'Experience' };
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-3xl px-4 md:px-6 pt-10 md:pt-16 pb-16 md:pb-24">
    <h1 class="text-4xl font-bold tracking-tight text-heading">Experience</h1>
    <p class="mt-3 text-muted">Professional and teaching experience.</p>
    <div class="mt-10">
      <EntryList entries={experience} />
    </div>
  </div>
</Layout>
